# ESP-IDF build output (large and regenerated by idf.py build)
**/build/

# Generated ESP-IDF configuration
**/sdkconfig
**/sdkconfig.old

# ESP-IDF Component Manager generated directory
**/managed_components/

# Editor and local machine settings
.vscode/
**/.vscode/
.idea/
*.code-workspace

# Temporary and cache files
**/__pycache__/
*.pyc
*.log
*.tmp
.DS_Store
Thumbs.db

# Local secrets (never commit real Wi-Fi passwords or keys)
.env
.env.*
secrets.*
credentials.*
*.p12
*.pfx

# Packaged copies: source folders are already tracked
*.zip
