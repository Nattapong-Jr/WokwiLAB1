{
  "version": 1,
  "author": "ESP32 I2C LCD Lab",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": -120,
      "attrs": {}
    },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd",
      "top": -150,
      "left": 100,
      "attrs": { "pins": "i2c" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:GND.1", "lcd:GND", "black", [ "v0" ] ],
    [ "esp:5V", "lcd:VCC", "red", [ "v0" ] ],
    [ "esp:21", "lcd:SDA", "green", [ "h0" ] ],
    [ "esp:22", "lcd:SCL", "blue", [ "h0" ] ]
  ],
  "dependencies": {}
}
